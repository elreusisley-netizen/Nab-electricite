# Copier ce fichier en .env.local (développement) et renseigner les mêmes
# variables dans Vercel > Settings > Environment Variables.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique (« publishable » ou « anon ») : peut être exposée au navigateur.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (« secret » ou « service_role ») : serveur uniquement, jamais NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Phase 3 : e-mails et anti-spam (facultatifs : sans eux, les demandes arrivent quand même dans l'admin)
RESEND_API_KEY=
# Adresse qui reçoit les notifications (sans domaine vérifié : l'adresse du compte Resend).
NOTIFICATION_EMAIL=nabelectricite@gmail.com
# À renseigner seulement quand un domaine est vérifié chez Resend, ex. « Électricité N.A.B. <contact@domaine.fr> ».
# Active aussi l'e-mail de confirmation envoyé au client.
RESEND_FROM=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
